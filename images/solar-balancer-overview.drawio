        </mxCell>
        <mxCell id="rulePause" value="⏸️ &lt;b&gt;Wallbox/app pause&lt;/b&gt;&lt;br&gt;if Prism is paused, the integration does not resume it automatically" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F5F8;strokeColor=#79879A;fontSize=15;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
