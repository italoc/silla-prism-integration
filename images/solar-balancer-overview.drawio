<mxfile host="app.diagrams.net" modified="2026-08-01T00:00:00.000Z" agent="Codex" version="30.0.4" type="device">
  <diagram id="solar-balancer-overview" name="Solar balancer">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#F7F9FC;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1320" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="Silla Prism Solar Balancer" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#16233A;" vertex="1" parent="1">
          <mxGeometry x="360" y="26" width="600" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Uses external energy sensors and Prism MQTT data to set EV current. In solar mode, the balancer owns the current limit." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontColor=#5D6B82;" vertex="1" parent="1">
          <mxGeometry x="210" y="72" width="900" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="laneInputs" value="Inputs" style="swimlane;html=1;rounded=1;arcSize=4;startSize=36;fillColor=#FFFFFF;strokeColor=#B9C3D3;fontSize=18;fontStyle=1;fontColor=#16233A;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="310" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="inputSolar" value="☀️&lt;br&gt;&lt;b&gt;Solar production sensor&lt;/b&gt;&lt;br&gt;Real PV power in W" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4C9;strokeColor=#D89B00;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneInputs">
          <mxGeometry x="28" y="58" width="255" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="inputHome" value="🏠&lt;br&gt;&lt;b&gt;Home load sensor&lt;/b&gt;&lt;br&gt;House load, optionally including EV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF1FF;strokeColor=#5B7EC8;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneInputs">
          <mxGeometry x="28" y="148" width="255" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="inputBattery" value="🔋&lt;br&gt;&lt;b&gt;Battery sensors&lt;/b&gt;&lt;br&gt;Power sign + optional SOC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E9F8EF;strokeColor=#3BAE63;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneInputs">
          <mxGeometry x="28" y="238" width="255" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="inputPrism" value="🔌&lt;br&gt;&lt;b&gt;Prism MQTT data&lt;/b&gt;&lt;br&gt;EV power, grid power, voltage, mode/state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0EAFE;strokeColor=#8261D1;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneInputs">
          <mxGeometry x="28" y="328" width="255" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="inputManual" value="✋&lt;br&gt;&lt;b&gt;Direct HA current limit&lt;/b&gt;&lt;br&gt;Allowed as a Prism command, but overridden while solar balancing is active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF0E8;strokeColor=#D16A35;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneInputs">
          <mxGeometry x="28" y="426" width="255" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="laneCalc" value="Controller decision" style="swimlane;html=1;rounded=1;arcSize=4;startSize=36;fillColor=#FFFFFF;strokeColor=#243B63;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#16233A;" vertex="1" parent="1">
          <mxGeometry x="410" y="125" width="500" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="stepRead" value="1&lt;br&gt;&lt;b&gt;Read and validate data&lt;/b&gt;&lt;br&gt;Wait if required values are missing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FF;strokeColor=#6689D6;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneCalc">
          <mxGeometry x="45" y="55" width="410" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="stepCorrect" value="2&lt;br&gt;&lt;b&gt;Correct house load&lt;/b&gt;&lt;br&gt;If the home load includes EV, subtract live Prism EV power first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FF;strokeColor=#6689D6;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneCalc">
          <mxGeometry x="45" y="135" width="410" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="stepSurplus" value="3&lt;br&gt;&lt;b&gt;Calculate usable surplus&lt;/b&gt;&lt;br&gt;solar - corrected home load - target export" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FF;strokeColor=#6689D6;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneCalc">
          <mxGeometry x="45" y="223" width="410" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="stepBattery" value="4&lt;br&gt;&lt;b&gt;Protect home battery&lt;/b&gt;&lt;br&gt;Reserve charge power by SOC; optional excess charge can become EV surplus" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E9F8EF;strokeColor=#3BAE63;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneCalc">
          <mxGeometry x="45" y="307" width="410" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="stepCurrent" value="5&lt;br&gt;&lt;b&gt;Choose current&lt;/b&gt;&lt;br&gt;Convert W to A, clamp between 6A and max, then apply deadband and ramp limits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3EEFF;strokeColor=#8261D1;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneCalc">
          <mxGeometry x="45" y="395" width="410" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="flow1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeColor=#243B63;strokeWidth=2;" edge="1" parent="laneCalc" source="stepRead" target="stepCorrect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeColor=#243B63;strokeWidth=2;" edge="1" parent="laneCalc" source="stepCorrect" target="stepSurplus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeColor=#243B63;strokeWidth=2;" edge="1" parent="laneCalc" source="stepSurplus" target="stepBattery">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow4" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeColor=#243B63;strokeWidth=2;" edge="1" parent="laneCalc" source="stepBattery" target="stepCurrent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="laneOutput" value="Output to Prism" style="swimlane;html=1;rounded=1;arcSize=4;startSize=36;fillColor=#FFFFFF;strokeColor=#B9C3D3;fontSize=18;fontStyle=1;fontColor=#16233A;" vertex="1" parent="1">
          <mxGeometry x="970" y="125" width="300" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="output6a" value="🌥️&lt;br&gt;&lt;b&gt;Low surplus&lt;/b&gt;&lt;br&gt;Keep solar mode at the calculated minimum, usually 6A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF8DE;strokeColor=#D89B00;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneOutput">
          <mxGeometry x="24" y="58" width="250" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="outputRamp" value="✅&lt;br&gt;&lt;b&gt;Enough surplus&lt;/b&gt;&lt;br&gt;Set target amps gradually" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E9F8EF;strokeColor=#3BAE63;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneOutput">
          <mxGeometry x="24" y="166" width="250" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="outputManual" value="🎯&lt;br&gt;&lt;b&gt;Balancer wins&lt;/b&gt;&lt;br&gt;If Current limit is changed manually, the next balancer cycle republishes its calculated target." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF0E8;strokeColor=#D16A35;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneOutput">
          <mxGeometry x="24" y="264" width="250" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="outputMqtt" value="📡&lt;br&gt;&lt;b&gt;MQTT commands&lt;/b&gt;&lt;br&gt;set_current_limit + solar mode" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0EAFE;strokeColor=#8261D1;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="laneOutput">
          <mxGeometry x="24" y="390" width="250" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="arrowInputs" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeWidth=3;strokeColor=#5D6B82;fontSize=13;fontColor=#5D6B82;" edge="1" parent="1" source="laneInputs" target="stepRead">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="390"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arrowCurrentToOut" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeWidth=3;strokeColor=#8261D1;fontSize=13;fontColor=#543A91;" edge="1" parent="1" source="stepCurrent" target="laneOutput">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="520"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="rulesTitle" value="Safety and stabilisation rules" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#16233A;" vertex="1" parent="1">
          <mxGeometry x="55" y="690" width="420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ruleAutolimit" value="🛡️ &lt;b&gt;Autolimit&lt;/b&gt;&lt;br&gt;Do not fight Prism protection. Probe 6A only when grid import returns inside the deadband, then wait 5 minutes before another probe." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6F0FF;strokeColor=#8261D1;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="730" width="360" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="rulePause" value="⏸️ &lt;b&gt;Wallbox/app pause&lt;/b&gt;&lt;br&gt;If Prism is paused, the integration does not resume charging automatically." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F5F8;strokeColor=#79879A;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="435" y="730" width="280" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="ruleExport" value="↗️ &lt;b&gt;Residual export recovery&lt;/b&gt;&lt;br&gt;If unused export stays available long enough, add current even from the 6A hold." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF7FF;strokeColor=#3B8AC4;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="730" width="280" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="ruleDiag" value="📊 &lt;b&gt;Diagnostic sensors&lt;/b&gt;&lt;br&gt;Expose surplus, corrected home load, target amps, countdowns and decision reason." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#243B63;fontSize=14;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1035" y="730" width="250" height="92" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
