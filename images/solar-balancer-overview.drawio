        </mxCell>
        <mxCell id="ruleLow" value="🌥️ &lt;b&gt;Low surplus&lt;/b&gt;&lt;br&gt;stays in solar mode at 6A without stopping charge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF8DE;strokeColor=#D89B00;fontSize=15;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="665" width="260" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="ruleLoad" value="🔥 &lt;b&gt;Heavy house load&lt;/b&gt;&lt;br&gt;reduces current quickly to avoid excessive import" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF0E8;strokeColor=#D16A35;fontSize=15;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="635" y="665" width="260" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="ruleExport" value="↗️ &lt;b&gt;Persistent export&lt;/b&gt;&lt;br&gt;if energy is exported for a while, amps rise even from 6A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF7FF;strokeColor=#3B8AC4;fontSize=15;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="925" y="665" width="280" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="ruleAutolimit" value="🛡️ &lt;b&gt;Prism autolimit&lt;/b&gt;&lt;br&gt;does not force restart while the wallbox is protecting itself; tries 6A only when grid import returns inside the deadband" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6F0FF;strokeColor=#8261D1;fontSize=15;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
