        </mxCell>
        <mxCell id="ruleSurplus" value="✅ &lt;b&gt;Enough surplus&lt;/b&gt;&lt;br&gt;computes target amps and ramps up gradually" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F7EE;strokeColor=#3BAE63;fontSize=15;fontColor=#1F2937;spacing=8;" vertex="1" parent="1">
